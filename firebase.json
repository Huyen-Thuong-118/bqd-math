{
  "hosting": {
    "site": "bqdmath",
    "public": "firebase-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "bqdmath-web",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
