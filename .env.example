# ===== Database (Neon hoặc Supabase — có pooled connection) =====
# DATABASE_URL: đọc bởi driver adapter trong src/lib/db.ts — dùng cho APP
# lúc chạy thật. PHẢI là connection string qua pooler.
#   Neon:     có "-pooler" trong hostname
#   Supabase: dùng cổng 6543 (PgBouncer), thêm ?pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/bqdmath?sslmode=require"

# DIRECT_URL: đọc bởi prisma.config.ts — dùng cho Prisma CLI (migrate,
# studio...). PHẢI là connection string KHÔNG qua pooler, vì migrate cần
# chạy DDL trực tiếp. Xem README mục "Vì sao có prisma.config.ts".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/bqdmath?sslmode=require"

# ===== NextAuth (Auth.js v5) =====
# v5 đọc AUTH_SECRET/AUTH_URL (NEXTAUTH_SECRET/NEXTAUTH_URL ở trên vẫn được
# alias cho tương thích ngược, nhưng src/auth.ts dùng tên mới bên dưới).
NEXTAUTH_URL="http://localhost:3000"
# Tạo secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Google OAuth Client — tạo ở Google Cloud Console, xem hướng dẫn cuối README
# phần NextAuth. Authorized redirect URI: {domain}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Seed tài khoản ADMIN (prisma/seed.ts) =====
# ADMIN không đăng ký qua form — chạy `npm run seed` để tạo/cập nhật (upsert
# theo email) đúng 1 tài khoản giáo viên với 3 biến dưới đây.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PHONE=""
SEED_ADMIN_PASSWORD=""

# ===== Cloudflare R2 (lưu PDF đề thi, tài liệu) =====
# Lấy ở Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="bqdmath-documents"
# URL public nếu bật public access cho bucket, hoặc để trống nếu chỉ dùng signed URL
R2_PUBLIC_URL=""

# ===== Cloudflare Stream (video lời giải) =====
# Lấy ở Cloudflare Dashboard > Stream, cần Workers Paid plan ($5/tháng)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

# ===== Email (Resend) =====
# Lấy API key ở https://resend.com/api-keys (cần tạo tài khoản Resend trước).
RESEND_API_KEY=""
# "onboarding@resend.dev" chỉ dùng được cho môi trường test (Resend giới hạn
# gửi tới chính email tài khoản Resend của bạn khi dùng domain mặc định này).
# Lên production: đổi sang domain riêng đã verify trong Resend dashboard,
# vd EMAIL_FROM="BQD Math <noreply@bqdmath.edu.vn>".
EMAIL_FROM="BQD Math <onboarding@resend.dev>"

# ===== Quên mật khẩu — token giữa bước xác thực OTP và đặt mật khẩu mới =====
# Ký bằng jose (HS256), hết hạn 10 phút — xem features/auth/lib/reset-token.ts.
# Tạo secret: openssl rand -base64 32
RESET_TOKEN_SECRET=""

# ===== Cron job (Vercel Cron — dọn tài khoản SUSPENDED quá hạn 30 ngày) =====
# Tạo secret: openssl rand -base64 32. Set trong Vercel dashboard → Settings
# → Environment Variables — Vercel tự đính kèm header
# "Authorization: Bearer $CRON_SECRET" khi gọi cron, không cần cấu hình gì
# thêm ở vercel.json. Xem app/api/cron/cleanup-suspended-accounts/route.ts.
CRON_SECRET=""

# ===== SMS (eSMS.vn hoặc SpeedSMS — tính phí) =====
SMS_API_KEY=""
SMS_BRAND_NAME=""

# ===== AI (Phase nâng cao — quét đề tự động) =====
ANTHROPIC_API_KEY=""
