# ===== Database local (PostgreSQL trong infra/docker-compose.yml) =====
# Local không có pooler nên app và Prisma CLI dùng cùng một URL.
DATABASE_URL="postgresql://bqdmath:bqdmath_dev@127.0.0.1:5432/bqdmath"
DIRECT_URL="postgresql://bqdmath:bqdmath_dev@127.0.0.1:5432/bqdmath"

# Verification scripts create/update/delete fixtures. Use a separate database,
# set both URLs to it, and opt in explicitly before running npm run verify:*.
# DATABASE_URL="postgresql://bqdmath:bqdmath_dev@127.0.0.1:5432/bqdmath_test"
# TEST_DATABASE_URL="postgresql://bqdmath:bqdmath_dev@127.0.0.1:5432/bqdmath_test"
# BQD_MATH_TEST_DATABASE="true"

# Cloud Run production dùng Cloud SQL qua Unix socket. DB_PASSWORD lấy từ
# Secret Manager; local không cần điền nhóm này.
CLOUD_SQL_CONNECTION_NAME=""
DB_USER="bqdmath"
DB_PASSWORD=""
DB_NAME="bqdmath"
# Chỉ Cloud Build/Auth Proxy dùng kết nối TCP cục bộ này.
DB_HOST=""
DB_PORT="5432"

# ===== NextAuth (Auth.js v5) =====
# v5 đọc AUTH_SECRET/AUTH_URL (NEXTAUTH_SECRET/NEXTAUTH_URL ở trên vẫn được
# alias cho tương thích ngược, nhưng src/auth.ts dùng tên mới bên dưới).
NEXTAUTH_URL="http://localhost:3000"
# Tạo secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""
# Cloud Run đứng sau reverse proxy của Google; Auth.js phải tin Host/X-Forwarded-*.
AUTH_TRUST_HOST="true"
# Dùng cùng một khóa lúc `next build` và runtime trên mọi Cloud Run instance.
# Tạo bằng: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Google OAuth Client — tạo ở Google Cloud Console, xem hướng dẫn cuối README
# phần NextAuth. Authorized redirect URI: {domain}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Seed tài khoản ADMIN (prisma/seed.ts) =====
# ADMIN không đăng ký qua form — chạy `npm run seed` để tạo/cập nhật (upsert
# theo email) đúng 1 tài khoản giáo viên với 3 biến dưới đây.
SEED_ADMIN_EMAIL="admin@bqdmath.local"
SEED_ADMIN_PHONE="0900000000"
SEED_ADMIN_PASSWORD="BqdMathDev123!"

# Dữ liệu demo lát cắt 1: một học sinh ACTIVE, một lớp và một đề 10 câu.
# Chỉ bật ở local/dev, KHÔNG bật trên production.
SEED_DEMO_DATA="false"
SEED_STUDENT_EMAIL="student@bqdmath.local"
SEED_STUDENT_PASSWORD="BqdMathStudent123!"

# ===== Google Cloud Storage (lưu PDF đề thi, tài liệu) =====
# Cloud Run dùng service account, không tạo hay lưu JSON key.
GCS_BUCKET_NAME=""

# OCR local (Tesseract vie+eng trong Docker, không cần API key/model host riêng)
OCR_SERVICE_URL="http://127.0.0.1:8001"

# ===== Vertex AI Gemini — đọc cấu trúc đề và trích đáp án từ PDF =====
# Production dùng service account/ADC, không lưu API key. Local chạy
# `gcloud auth application-default login` trước khi thử Gemini.
GOOGLE_GENAI_USE_ENTERPRISE="true"
GOOGLE_CLOUD_PROJECT="bqd-math-507809"
GOOGLE_CLOUD_LOCATION="global"
GEMINI_MODEL="gemini-3.1-flash-lite"

# ===== Cloudflare Stream (video lời giải) =====
# Lấy ở Cloudflare Dashboard > Stream, cần Workers Paid plan ($5/tháng)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

# ===== Email (Resend) =====
# Lấy API key ở https://resend.com/api-keys (cần tạo tài khoản Resend trước).
RESEND_API_KEY=""
# "onboarding@resend.dev" chỉ dùng được cho môi trường test (Resend giới hạn
# gửi tới chính email tài khoản Resend của bạn khi dùng domain mặc định này).
# Lên production: đổi sang domain riêng đã verify trong Resend dashboard,
# vd EMAIL_FROM="BQD Math <noreply@bqdmath.edu.vn>".
EMAIL_FROM="BQD Math <onboarding@resend.dev>"

# ===== Quên mật khẩu — token giữa bước xác thực OTP và đặt mật khẩu mới =====
# Ký bằng jose (HS256), hết hạn 10 phút — xem features/auth/lib/reset-token.ts.
# Tạo secret: openssl rand -base64 32
RESET_TOKEN_SECRET=""

# ===== Cron job (Cloud Scheduler — dọn tài khoản SUSPENDED quá hạn 30 ngày) =====
# Tạo secret: openssl rand -base64 32. Scheduler gọi route với header
# "Authorization: Bearer $CRON_SECRET". Xem hướng dẫn GCP trong docs/.
CRON_SECRET=""

# ===== SMS (eSMS.vn hoặc SpeedSMS — tính phí) =====
SMS_API_KEY=""
SMS_BRAND_NAME=""

# ===== AI (Phase nâng cao — quét đề tự động) =====
ANTHROPIC_API_KEY=""
