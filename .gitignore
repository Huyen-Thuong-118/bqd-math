# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...trừ file mẫu: cần commit để biết dự án dùng những biến nào
!.env.example

# PDF upload local khi chưa cấu hình Cloudflare R2
storage/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (local sqlite/dev db files, if any)
/prisma/*.db
/prisma/dev.db*

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
